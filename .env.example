# ─────────────────────────────────────────────────────────────
# The River Church — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` (it is gitignored).
# ─────────────────────────────────────────────────────────────

# Resend API key — get one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where "Plan Your Visit" form submissions are delivered (church inbox)
CONTACT_FORM_TO=office@theriverchurchinc.com

# Verified Resend sender. Must be on a domain you've verified in Resend,
# or use the shared onboarding sender for testing: onboarding@resend.dev
CONTACT_FORM_FROM=The River Church <noreply@theriverchurchinc.com>

# Public site origin (no trailing slash). Used for canonical URLs,
# sitemap, robots, Open Graph and metadataBase.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://theriverchurchinc.com
